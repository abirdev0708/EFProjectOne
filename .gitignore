## .NET / Visual Studio / VS Code .gitignore

# Build results
bin/
obj/
out/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider
.idea/

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# EF Core
Migrations/*.Designer.cs.orig

# ASP.NET Core
appsettings.Development.json
appsettings.*.json
!appsettings.json

# Secrets (never commit these)
secrets.json
*.pfx
*.key

# Logs
*.log
logs/

# OS generated files
.DS_Store
Thumbs.db

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# Rider/JetBrains
*.sln.iml

# Environment
.env
.env.local
dotnet-install.sh